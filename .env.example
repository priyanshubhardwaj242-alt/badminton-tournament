# Copy to .env and edit. Never commit .env.
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/tournament.db
NODE_ENV=production
# Set to 1 when served over HTTPS (adds Secure flag to the session cookie)
COOKIE_SECURE=0
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Set to 0 to stop 'npm start' from opening your browser automatically
OPEN_BROWSER=1
